# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys). Estes dois valores são públicos por natureza.
# NUNCA coloque aqui a chave "secret"/"service_role" nem a senha do banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Endereço público do site (usado nos links enviados por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
